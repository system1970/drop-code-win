{
  "name": "drop-code-win",
  "version": "1.0.0",
  "description": "A warm, drop-down AI coding terminal for Windows.",
  "author": "system1970",
  "license": "MIT",
  "homepage": "https://github.com/system1970/drop-code-win#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/system1970/drop-code-win.git"
  },
  "bugs": {
    "url": "https://github.com/system1970/drop-code-win/issues"
  },
  "keywords": [
    "terminal",
    "ai",
    "opencode",
    "codex",
    "claude",
    "dropdown",
    "quake",
    "windows"
  ],
  "main": "out/main/index.js",
  "type": "commonjs",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "compile": "tsc -p tsconfig.main.json",
    "build:preload": "esbuild src/preload/preload.ts --bundle --platform=node --external:electron --format=cjs --outfile=out/preload/preload.js --sourcemap",
    "build:renderer": "vite build",
    "build": "npm run compile && npm run build:preload && npm run build:renderer",
    "dev": "npm run compile && concurrently -k -n VITE,ELECTRON -c blue,green \"vite\" \"cross-env ELECTRON_RENDERER_URL=http://localhost:5173 electron .\"",
    "start": "electron .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "icon": "node scripts/generate-icon.mjs",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:store": "npm run build && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "eslint": "^9.14.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
